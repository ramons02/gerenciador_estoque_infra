# Ambiente: LOCAL (desenvolvimento)
# Fonte da verdade das variáveis de ambiente da aplicação.
# A API le todas as variaveis por parametrizacao (${VAR}) - nunca hardcoded.
# ATENCAO: a senha real fica apenas na maquina local - preencher manualmente
# em uma copia (ex: env/dev.local.env) e NAO commitar a credencial.

# --- Banco de dados PostgreSQL (Neon - projeto round-water-07779373) ---
DB_HOST=ep-still-bar-aycqhg1n-pooler.c-5.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=<preencher localmente (senha do Neon)>
DB_SSL_PARAMS=?sslmode=require

# --- Perfil ativo do Spring ---
SPRING_PROFILES_ACTIVE=local

# --- CORS (origens permitidas) ---
APP_CORS_ORIGINS=http://localhost:5173

# --- API ---
PORT=8080