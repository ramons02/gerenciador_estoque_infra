# Ambiente: PRODUCAO (Render)
# Banco: Neon (projeto round-water-07779373). Valores injetados pelo blueprint
# (render.yaml da API). NAO commitar credenciais reais - a senha e preenchida
# manualmente no painel do Render (variavel com sync: false).

# --- Banco de dados PostgreSQL (Neon) ---
DB_HOST=ep-still-bar-aycqhg1n-pooler.c-5.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=<preencher no painel do Render>
DB_SSL_PARAMS=?sslmode=require

# --- Perfil ativo do Spring ---
SPRING_PROFILES_ACTIVE=prod

# --- CORS (origens permitidas) ---
APP_CORS_ORIGINS=https://gerenciador-estoque-app.onrender.com

# --- API ---
PORT=8080