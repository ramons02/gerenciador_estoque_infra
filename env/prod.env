# Ambiente: PRODUCAO (Render)
# Valores preenchidos pelo Render ao criar o blueprint (render.yaml da API).
# NAO commitar credenciais reais - o Render injeta automaticamente via fromDatabase.

# --- Banco de dados PostgreSQL (gerenciador-estoque-db - Render) ---
DB_HOST=gerenciador-estoque-db (preenchido pelo Render)
DB_PORT=5432
DB_NAME=gerenciador_estoque
SPRING_DATASOURCE_USERNAME=<preenchido pelo Render>
SPRING_DATASOURCE_PASSWORD=<preenchido pelo Render>

# --- Perfil ativo do Spring ---
SPRING_PROFILES_ACTIVE=prod

# --- CORS (origens permitidas) ---
APP_CORS_ORIGINS=https://gerenciador-estoque-app.onrender.com

# --- API ---
PORT=8080